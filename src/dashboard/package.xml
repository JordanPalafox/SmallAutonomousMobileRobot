<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>dashboard</name>
  <version>0.1.0</version>
  <description>Flask web dashboard for AMR robot: real-time telemetry, MJPEG video stream, and mission control</description>
  <maintainer email="jordanpalafoxs@gmail.com">Jordan</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>python3-numpy</depend>

  <exec_depend>python3-flask</exec_depend>
  <exec_depend>python3-flask-socketio</exec_depend>
  <!-- pydub + ffmpeg let the /api/voice endpoint decode WebM/Opus blobs that
       browsers' MediaRecorder produces by default. -->
  <exec_depend>python3-pydub</exec_depend>
  <exec_depend>ffmpeg</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
