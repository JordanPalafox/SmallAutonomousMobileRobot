<?xml version="1.0"?>
<robot name="puzzlebot" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- Arguments -->
  <xacro:arg name="is_ignition" default="true"/>
  <xacro:arg name="is_sim" default="true"/>
  <!-- use_gz_control=false → robot SOLO-VISUAL (sin plugin ros2_control): para el
       gemelo-espejo, donde la pose se fija desde el robot real, no por físicas. -->
  <xacro:arg name="use_gz_control" default="true"/>

  <!-- LiDAR is mounted rear-facing on the real robot (cable toward back).
       Rotate 180° in real mode so the scan aligns with +X forward. -->
  <xacro:property name="lidar_yaw" value="${0.0 if '$(arg is_sim)' == 'true' else 3.141592653589793}"/>

  <!-- Include Gazebo plugins -->
  <xacro:include filename="$(find description)/urdf/puzzlebot_gazebo.xacro" />

  <!-- Include ros2_control (omitido en modo solo-visual / gemelo-espejo) -->
  <xacro:if value="$(arg use_gz_control)">
    <xacro:include filename="$(find description)/urdf/puzzlebot_ros2_control.xacro" />
  </xacro:if>

  <!-- ==================== PROPERTIES ==================== -->
  <xacro:property name="wheel_radius"    value="0.05"/>
  <xacro:property name="wheel_separation" value="0.19"/>
  <xacro:property name="base_mass"  value="1.0"/>
  <xacro:property name="wheel_mass" value="0.1"/>
  <xacro:property name="caster_mass" value="0.01"/>

  <!-- mm → m for lifter STL meshes -->
  <xacro:property name="s" value="0.001"/>

  <!-- Inertia macros -->
  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*(3*r*r+h*h)/12}" ixy="0.0" ixz="0.0"
               iyy="${m*(3*r*r+h*h)/12}" iyz="0.0"
               izz="${m*r*r/2}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="box_inertia" params="m x y z">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*(y*y+z*z)/12}" ixy="0.0" ixz="0.0"
               iyy="${m*(x*x+z*z)/12}" iyz="0.0"
               izz="${m*(x*x+y*y)/12}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="sphere_inertia" params="m r">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${2*m*r*r/5}" ixy="0.0" ixz="0.0"
               iyy="${2*m*r*r/5}" iyz="0.0"
               izz="${2*m*r*r/5}"/>
    </inertial>
  </xacro:macro>

  <!-- ==================== ROBOT LINKS ==================== -->

  <link name="base_footprint"/>

  <link name="base_link">
    <xacro:box_inertia m="${base_mass}" x="0.2" y="0.15" z="0.06"/>
    <visual>
      <geometry>
        <mesh filename="package://description/meshes/Puzzlebot_Jetson_Lidar_Edition_Base.stl"/>
      </geometry>
      <material name="dark_grey">
        <color rgba="0.3 0.3 0.3 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.2 0.15 0.06"/>
      </geometry>
    </collision>
  </link>

  <link name="wheel_right_link">
    <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" h="0.02"/>
    <visual>
      <origin xyz="0 0 0" rpy="-1.5708 0 0"/>
      <geometry>
        <mesh filename="package://description/meshes/Puzzlebot_Wheel.stl"/>
      </geometry>
      <material name="grey">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <sphere radius="${wheel_radius}"/>
      </geometry>
    </collision>
  </link>

  <link name="wheel_left_link">
    <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" h="0.02"/>
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <mesh filename="package://description/meshes/Puzzlebot_Wheel.stl"/>
      </geometry>
      <material name="grey">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <sphere radius="${wheel_radius}"/>
      </geometry>
    </collision>
  </link>

  <link name="caster_link">
    <xacro:sphere_inertia m="${caster_mass}" r="0.015"/>
    <visual>
      <origin xyz="0 0 -0.015" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://description/meshes/Puzzlebot_Caster_Wheel.stl"/>
      </geometry>
      <material name="grey">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.015"/>
      </geometry>
    </collision>
  </link>

  <link name="lidar_link">
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
    <visual>
      <geometry>
        <cylinder radius="0.03" length="0.02"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.03" length="0.02"/>
      </geometry>
    </collision>
  </link>

  <link name="camera_link">
    <inertial>
      <mass value="0.02"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.02 0.06 0.02"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.02 0.06 0.02"/>
      </geometry>
    </collision>
  </link>

  <link name="imu_link">
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/>
    </inertial>
  </link>

  <!-- ==================== LIFTER LINKS ==================== -->

  <!-- Outer mast / fork base (4-mast-1.stl)
       Physical size in world frame: 55 × 22.4 × 170 mm -->
  <link name="lifter_base_link">
    <visual>
      <origin xyz="-0.1125 -0.0112 0.1125" rpy="1.5708 3.14159 3.14159"/>
      <geometry>
        <mesh filename="package://description/meshes/lifter/outer_mast.stl"
              scale="${s} ${s} ${s}"/>
      </geometry>
      <material name="off_white">
        <color rgba="0.93 0.93 0.87 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.055 0.0224 0.170"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.000123" ixy="0" ixz="0"
               iyy="0.000133" iyz="0" izz="0.0000147"/>
    </inertial>
  </link>

  <!-- Inner mast (Frantic Albar-Hillar (9).stl)
       Physical size in world frame: 49 × 11.6 × 171 mm -->
  <link name="mast_inner_link">
    <visual>
      <origin xyz="-0.0655 0.0058 -0.0050" rpy="1.5708 0 0"/>
      <geometry>
        <mesh filename="package://description/meshes/lifter/mast_inner.stl"
              scale="${s} ${s} ${s}"/>
      </geometry>
      <material name="off_white">
        <color rgba="0.93 0.93 0.87 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.049 0.0116 0.171"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.03"/>
      <inertia ixx="0.0000608" ixy="0" ixz="0"
               iyy="0.0000665" iyz="0" izz="0.00000634"/>
    </inertial>
  </link>

  <!-- Carriage (8-carriage.stl)
       Physical size in world frame: 80 × 96.5 × 55.9 mm -->
  <link name="carriage_link">
    <visual>
      <origin xyz="-0.1125 -0.11343 -0.02793" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://description/meshes/lifter/carriage.stl"
              scale="${s} ${s} ${s}"/>
      </geometry>
      <material name="light_grey">
        <color rgba="0.80 0.80 0.75 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.080 0.0965 0.0559"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.02"/>
      <inertia ixx="0.0000207" ixy="0" ixz="0"
               iyy="0.0000159" iyz="0" izz="0.0000262"/>
    </inertial>
  </link>

  <!-- Camera pan holder (camera_holder.stl) — rotates on top of inner mast -->
  <link name="cam_holder_link">
    <visual>
      <origin xyz="0.0285 -0.0055 0.0715" rpy="-1.5708 0 0"/>
      <geometry>
        <mesh filename="package://description/meshes/lifter/camera_holder.stl"
              scale="${s} ${s} ${s}"/>
      </geometry>
      <material name="light_grey">
        <color rgba="0.80 0.80 0.75 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.01125" rpy="0 0 0"/>
      <geometry>
        <box size="0.041 0.009 0.0225"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.01125" rpy="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>

  <!-- Mast camera (camera.stl) — fixed to the pan holder -->
  <link name="mast_camera_link">
    <visual>
      <origin xyz="-0.0005 0.0290 0.0005" rpy="-1.5708 0 3.14159"/>
      <geometry>
        <mesh filename="package://description/meshes/lifter/camera.stl"
              scale="${s} ${s} ${s}"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.041 0.041 0.014"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>

  <!-- ==================== ROBOT JOINTS ==================== -->

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child  link="base_link"/>
    <origin xyz="0.0 0.0 0.05" rpy="0.0 0.0 0.0"/>
  </joint>

  <joint name="wheel_right_joint" type="continuous">
    <parent link="base_link"/>
    <child  link="wheel_right_link"/>
    <origin xyz="0.052 -0.095 -0.0025" rpy="0.0 0.0 0.0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <joint name="wheel_left_joint" type="continuous">
    <parent link="base_link"/>
    <child  link="wheel_left_link"/>
    <origin xyz="0.052 0.095 -0.0025" rpy="0.0 0.0 0.0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="caster_link"/>
    <origin xyz="-0.095 0 -0.0307" rpy="0 0 0"/>
  </joint>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="lidar_link"/>
    <origin xyz="0.04 0.0 0.12" rpy="0.0 0.0 ${lidar_yaw}"/>
  </joint>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="camera_link"/>
    <origin xyz="0.1 0.0 0.02" rpy="0.0 0.0 0.0"/>
  </joint>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="imu_link"/>
    <origin xyz="0.0 0.0 0.04" rpy="0.0 0.0 0.0"/>
  </joint>

  <!-- ==================== LIFTER JOINTS ==================== -->

  <!-- Attach outer mast to the front of the robot body.
       X=0.10  places the mast at the robot's front face.
       Z=0.035 raises the lifter_base_link so the mast bottom sits at ground level
               (base_link is 0.05 m above ground; 0.05 + 0.035 = 0.085 m, matching
               the standalone lifter's world_to_lifter_base Z offset). -->
  <joint name="lifter_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="lifter_base_link"/>
    <origin xyz="0.125 0 0.050" rpy="0 0 1.5708"/>
  </joint>

  <!-- Inner mast: slides up inside outer mast -->
  <joint name="mast_inner_joint" type="prismatic">
    <parent link="lifter_base_link"/>
    <child  link="mast_inner_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="0.0" upper="0.10" effort="100.0" velocity="0.10"/>
    <dynamics damping="10.0" friction="2.0"/>
  </joint>

  <!-- Carriage: slides up on inner mast -->
  <joint name="carriage_joint" type="prismatic">
    <parent link="mast_inner_link"/>
    <child  link="carriage_link"/>
    <origin xyz="0 -0.0420 -0.0498" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="0.0" upper="0.10" effort="50.0" velocity="0.10"/>
    <dynamics damping="10.0" friction="2.0"/>
  </joint>

  <!-- Pan holder: revolute around X at top of inner mast -->
  <joint name="cam_holder_joint" type="fixed">
    <parent link="mast_inner_link"/>
    <child  link="cam_holder_link"/>
    <origin xyz="0 0 0.105" rpy="0.3491 0 0"/>  <!-- tilt camara 20deg hacia abajo (antes 45deg=0.7854) -->
  </joint>

  <!-- Camera: fixed to the pan holder, sits on top of bracket
       z=0.030: bracket top (0.0225) + half camera height (0.007) = 0.0295 ≈ 0.030m -->
  <joint name="mast_camera_joint" type="fixed">
    <parent link="cam_holder_link"/>
    <child  link="mast_camera_link"/>
    <origin xyz="0 0 0.033" rpy="0 0 0"/>
  </joint>

  <!-- ==================== MATERIALS ==================== -->
  <material name="dark_grey">
    <color rgba="0.3 0.3 0.3 1.0"/>
  </material>
  <material name="grey">
    <color rgba="0.5 0.5 0.5 1.0"/>
  </material>
  <material name="black">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>
  <material name="off_white">
    <color rgba="0.93 0.93 0.87 1.0"/>
  </material>
  <material name="light_grey">
    <color rgba="0.80 0.80 0.75 1.0"/>
  </material>

</robot>