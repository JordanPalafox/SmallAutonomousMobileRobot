<?xml version="1.0"?>
<robot name="puzzlebot" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- Drive wheels - high friction -->
  <gazebo reference="wheel_left_link">
    <mu1>1000000000000000.0</mu1>
    <mu2>1000000000000000.0</mu2>
    <kp>1000000000000.0</kp>
    <kd>10.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.1</maxVel>
    <fdir1>1 0 0</fdir1>
  </gazebo>

  <gazebo reference="wheel_right_link">
    <mu1>1000000000000000.0</mu1>
    <mu2>1000000000000000.0</mu2>
    <kp>1000000000000.0</kp>
    <kd>10.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.1</maxVel>
    <fdir1>1 0 0</fdir1>
  </gazebo>

  <!-- Caster wheel - low friction -->
  <gazebo reference="caster_link">
    <mu1>0.1</mu1>
    <mu2>0.1</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>1.0</maxVel>
  </gazebo>

  <!-- ROS 2 Control (Sensors system is loaded at the world level — do not repeat here) -->
  <!-- Plugin de control omitido en modo solo-visual (gemelo-espejo). -->
  <xacro:if value="$(arg use_gz_control)">
    <gazebo>
      <xacro:if value="$(arg is_ignition)">
        <plugin filename="ign_ros2_control-system" name="ign_ros2_control::IgnitionROS2ControlPlugin">
          <parameters>$(find controller)/config/puzzlebot_controllers.yaml</parameters>
        </plugin>
      </xacro:if>

      <xacro:unless value="$(arg is_ignition)">
        <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
          <parameters>$(find controller)/config/puzzlebot_controllers.yaml</parameters>
        </plugin>
      </xacro:unless>
    </gazebo>
  </xacro:if>

  <!-- Modo solo-visual (gemelo-espejo): robot ESTÁTICO (sin físicas) — la pose
       la fija gemelo_mirror vía set_pose; así no se cae ni rueda. -->
  <xacro:unless value="$(arg use_gz_control)">
    <gazebo>
      <static>true</static>
    </gazebo>
  </xacro:unless>

  <!-- Mast camera sensor -->
  <gazebo reference="mast_camera_link">
    <sensor name="mast_camera" type="camera">
      <pose>0 0 0 0 0 -1.5708</pose>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>30</update_rate>
      <topic>/mast_camera/image_raw</topic>
      <gz_frame_id>mast_camera_link</gz_frame_id>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>  <!-- 60 deg -->
        <image>
          <width>640</width>
          <height>360</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>10.0</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.007</stddev>
        </noise>
      </camera>
    </sensor>
  </gazebo>

  <!-- 2D Lidar sensor (gpu_lidar uses render engine for raycasting in Ignition) -->
  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <topic>scan</topic>
      <update_rate>10</update_rate>
      <gz_frame_id>lidar_link</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1.0</resolution>
            <min_angle>0.0</min_angle>
            <max_angle>6.28</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>20.0</max>
          <resolution>0.02</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

</robot>
