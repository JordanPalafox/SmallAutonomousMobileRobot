<?xml version="1.0" ?>
<!--
  warehouse_rack — single pallet rack unit.

  STL bounding box (in mm):  X: -12..0  Y: -31..+4  Z: 0..+26.5
  Scale 0.03 (mm → 3 cm per unit) gives:
    depth  (X)  = 0.36 m
    length (Y)  = 1.05 m   (4 × 0.03 = 0.12 m overhang at +Y end)
    height (Z)  = 0.795 m

  Visual pose offset (0.18, 0.405, 0) centres the mesh on the link origin in XY,
  so the model pose can be placed at the footprint centre.

  Collision uses a bounding box; Z offset 0.3975 = half height so the box
  sits on the ground with the model origin at floor level.
-->
<sdf version="1.6">
  <model name="warehouse_rack">
    <static>true</static>
    <link name="link">

      <visual name="visual">
        <pose>0.18 0.405 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://description/meshes/full_rack.stl</uri>
            <scale>0.03 0.03 0.03</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.18 0.22 0.40 1</ambient>
          <diffuse>0.18 0.22 0.40 1</diffuse>
          <specular>0.40 0.40 0.45 1</specular>
        </material>
      </visual>

      <collision name="collision">
        <pose>0 0 0.3975 0 0 0</pose>
        <geometry>
          <box><size>0.36 1.05 0.795</size></box>
        </geometry>
      </collision>

    </link>
  </model>
</sdf>